# LLM API Configuration
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Redis Working Memory Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL (pgvector) Episodic & Semantic Memory Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Embedding Model Configuration
# Uses sentence-transformers locally or API provider
EMBEDDING_MODEL_NAME=shibing624/text2vec-base-chinese
EMBEDDING_DIMENSION=768

# Memory Strategy Parameters
WORKING_MEMORY_WINDOW_SIZE=10
WORKING_MEMORY_TTL_SECONDS=86400
EPISODIC_SUMMARY_INTERVAL=5
FORGETTING_THRESHOLD=0.3
TIME_DECAY_LAMBDA=0.01
